# ── Database path (REQUIRED) ──────────────────────────────────────────────────
# PRD environment uses commander.db; UAT uses commander-uat.db.
# The server will exit immediately with a descriptive error if this is unset.
DB_PATH=./commander.db

# GITHUB_REPO is auto-detected from `git remote get-url origin`.
# Uncomment below only if you need to override it (e.g. monitoring a different repo):
# GITHUB_REPO=owner/repo

# Dedicated throwaway repo for tester-side GitHub issue/label operations.
# When set, the tester agent creates issues and applies labels here, not on GITHUB_REPO.
# When unset, tester skips live issue/label verification and notes it in the report.
# GITHUB_ISSUE_TEST_REPO=owner/repo-for-testing

GITHUB_DEFAULT_BRANCH=main

# GitHub token for headless `gh` auth (issue #772). A launchd-started process is
# detached from the login session and cannot read the macOS keychain, so `gh`
# fails the startup repo check. `gh` prefers GH_TOKEN over the keychain. The
# launchd installer (scripts/install_launchd.sh --gh-token ...) writes this for
# you; set it manually only for non-launchd runs. Never commit a real value.
# GH_TOKEN=

# Anthropic API key — required if using the API surface directly (e.g. claude CLI
# in API mode) rather than the Claude Code OAuth flow. Never commit a real value.
# ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Comma-separated repos to show on the Projects tab (auto-detected if omitted)
# TRACKED_REPOS=owner/repo1,owner/repo2

# Sprint length in days (default 14)
# SPRINT_DURATION_DAYS=14

# ntfy push notification topic URL (used by --alert-mode ntfy)
# NTFY_TOPIC_URL=https://ntfy.sh/<random-topic>

# Alert modes passed to sprint_manager on every dashboard-launched sprint.
# Comma-separated; sprint_manager validates the value. Default: dashboard_banner,ntfy
# COMMANDER_ALERT_MODES=dashboard_banner,ntfy

# Optional product surfaces (default 1 = disabled). Global Settings can also
# toggle these; env vars win when explicitly set.
# COMMANDER_DISABLE_SIGNOFF=1
# COMMANDER_DISABLE_ADVISOR=1
# COMMANDER_DISABLE_PLANNING=1
# COMMANDER_DISABLE_SPRINT_GOAL_REQUIRED=1

# Static bearer token for write endpoints (issue #1864).
# When set, all POST/PUT/PATCH/DELETE requests require:
#   Authorization: Bearer <token>
# GET/SSE are always open. 127.0.0.1 callers (same-host hooks) are exempt.
# Browser UI has the token injected automatically. When unset: no auth (default).
# COMMANDER_API_TOKEN=<generate-with: python3 -c "import secrets; print(secrets.token_hex(32))">
