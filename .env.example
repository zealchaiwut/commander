# Commander — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# Path to the SQLite database file. The server exits immediately if unset.
# PRD typically uses commander.db; UAT uses commander-uat.db.
DB_PATH=./commander.db


# ── Application ───────────────────────────────────────────────────────────────
# Deployment environment tag. Valid: prd, uat
ENVIRONMENT=prd

# HTTP port to listen on (default 8000 for PRD, 8001 for UAT)
PORT=8000


# ── GitHub Integration ────────────────────────────────────────────────────────
# Target GitHub repository (auto-detected from `git remote get-url origin`).
# Override here only if you need to point at a different repo.
# GITHUB_REPO=owner/repo

# Default branch name for new PRs and base comparisons
GITHUB_DEFAULT_BRANCH=main

# Comma-separated list of repos shown on the Projects tab.
# If omitted, repos are auto-detected from sprint config.
# TRACKED_REPOS=owner/repo1,owner/repo2

# Dedicated throwaway repo for tester-side label/issue operations.
# When set, the tester agent creates issues here, not on GITHUB_REPO.
# GITHUB_ISSUE_TEST_REPO=owner/sandbox-repo-for-testing


# ── Anthropic API ─────────────────────────────────────────────────────────────
# Only required when calling the Anthropic API directly (not via Claude Code CLI).
# Leave unset when using a Claude.ai subscription via the CLI — the CLI handles auth.
# ANTHROPIC_API_KEY=sk-ant-your-key-here


# ── Hooks ─────────────────────────────────────────────────────────────────────
# URL where Claude Code hooks POST agent events (tool calls, completions).
# Change only if your dashboard runs on a non-default port.
HOOK_POST_TARGET=http://localhost:8000/api/agent-event


# ── Notifications — ntfy (optional) ──────────────────────────────────────────
# Full ntfy topic URL. Pick a random topic name at https://ntfy.sh.
# NTFY_TOPIC_URL=https://ntfy.sh/your-random-topic-name-here

# Alert channels dispatched by sprint_manager on every sprint launch.
# Comma-separated. Valid values: dashboard_banner, ntfy, discord, email
# COMMANDER_ALERT_MODES=dashboard_banner,ntfy


# ── Notifications — Discord (optional) ───────────────────────────────────────
# Full Discord incoming webhook URL.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/your-webhook-token-here


# ── Notifications — Email / SMTP (optional) ───────────────────────────────────
# Required only when COMMANDER_ALERT_MODES includes "email".
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-smtp-app-password-here
# ALERT_EMAIL_TO=recipient@example.com


# ── Neon Database — Postgres (optional) ───────────────────────────────────────
# Required only for sprint_manager Postgres features (alembic migrations, etc).
# Create a free Neon project at https://neon.tech.
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require


# ── Token Usage Limits (optional) ────────────────────────────────────────────
# Enables the /api/token-budget endpoint. All three must be set to activate.
# WINDOW_TOKEN_LIMIT=100000
# WINDOW_DURATION_HOURS=5
# WEEKLY_TOKEN_LIMIT=500000
# PLAN_TYPE=pro


# ── Sprint Configuration (optional) ──────────────────────────────────────────
# Length of each sprint in calendar days (default 14)
# SPRINT_DURATION_DAYS=14

# Goal string shown in sprint summaries
# SPRINT_GOAL=Ship feature X


# ── Commander Internals (optional) ────────────────────────────────────────────
# Base directory where Commander project worktrees live (default: ~/commander)
# COMMANDER_BASE=/Users/you/dev

# Path to the tester agent worktree (default: <COMMANDER_BASE>/tester)
# WORKTESTER_ROOT=/Users/you/dev/commander/tester

# Log level for Commander services (default INFO)
# COMMANDER_LOG_LEVEL=INFO

# Sandbox repo used by tests and github_client in non-production contexts
# COMMANDER_TEST_REPO=owner/sandbox-repo

# Merge target branch for sprint PRs (set by sprint_manager before dispatching coder)
# COMMANDER_MERGE_TARGET=develop

# Path for the file-based sprint outcome snapshot written atomically at sprint end.
# External pollers (e.g. Hermes) read this file so they always have a consistent
# artifact regardless of webhook delivery state.
# Default: /var/run/commander/commander_report.latest.json
# COMMANDER_REPORT_PATH=/var/run/commander/commander_report.latest.json


# ── Agent Timeouts (optional) ─────────────────────────────────────────────────
# Seconds before an idle Claude agent is auto-timed-out (default 300)
# AGENT_IDLE_TIMEOUT_SECONDS=300

# Timeout for the per-ticket estimator agent subprocess (default 300)
# ESTIMATOR_TIMEOUT_SEC=300

# Timeout for the sprint preflight check subprocess (default 120)
# PREFLIGHT_TIMEOUT_SEC=120

# Timeout for bulk-BA ticket creation (default 90)
# BULK_CREATE_BA_TIMEOUT_SEC=90
