<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <!-- Service identity -->
  <key>Label</key>
  <string>com.commander.dashboard</string>

  <!-- Run on user login -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Restart only on non-zero exit (crash), not on clean shutdown -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- Working directory: commander repo root (installer substitutes __COMMANDER_ROOT__) -->
  <key>WorkingDirectory</key>
  <string>__COMMANDER_ROOT__</string>

  <!-- Launch command -->
  <key>ProgramArguments</key>
  <array>
    <string>__VENV_BIN__/uvicorn</string>
    <string>server:app</string>
    <string>--host</string>
    <string>0.0.0.0</string>
    <string>--port</string>
    <string>8000</string>
  </array>

  <!-- Use virtualenv binaries -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__VENV_BIN__:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>ENVIRONMENT</key>
    <string>prd</string>
  </dict>

  <!-- Log files -->
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/commander-dashboard.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/commander-dashboard.err.log</string>

</dict>
</plist>
