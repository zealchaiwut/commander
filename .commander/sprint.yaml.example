# Sprint Manager configuration — COPY THIS to .commander/sprint.yaml and edit paths.
#
# After cloning the repo, run: ./.commander/setup.sh
# That script fills in $HOME automatically. Edit the resulting sprint.yaml
# if your local layout differs from the standard ~/dev/commander/{coder,tester,prd} setup.

repo_name: zealchaiwut/commander

worktrees:
  coder: /Users/USER/dev/commander/coder
  tester: /Users/USER/dev/commander/tester
  tester_app_subdir: apps/dashboard

paths:
  scripts_dir: /Users/USER/dev/commander/prd/scripts
  logs_dir: /Users/USER/dev/commander/.commander/logs
  sprints_dir: /Users/USER/dev/commander/.commander/sprints
  alerts_dir: /Users/USER/dev/commander/.commander/alerts

dashboard:
  api_url: http://localhost:8000

# Optional — per-project port detection (issue #62)
# app:
#   default_port: 8000
#   port_strategy: prefer_default

# Optional — documentor agent (issue #103)
# When true, sprint manager runs the documentor after each tester passes UAT,
# committing minimal README/CLAUDE.md updates and posting a UAT comment.
# documentor_enabled: false

# Optional — coder backend (issues #916–#920). Default: claude-code everywhere.
# Setup: bash scripts/setup_cline.sh  (see docs/features/coder-backends.md)
#
# agent_config:
#   coder_model: claude-sonnet-4-6
#   coder:
#     backend: claude-code          # or cline for every coder dispatch
#   use_cline_followups: false      # true = Cline only on follow-up tickets (.clinerules required)
